{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SpotWin",
  "version": "0.1.0",
  "identifier": "com.deadgirl.spotwin",
  "build": {
    "frontendDist": "../frontend",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "SpotWin",
        "width": 275,
        "height": 116,
        "minWidth": 275,
        "minHeight": 116,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "center": true
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "Spotify in a Winamp skin",
    "longDescription": "Spotify wrapped in a Winamp2 skin via Webamp, with free-user ad blocking.",
    "linux": {
      "deb": {
        "depends": [
          "webkit2gtk-4.1",
          "gtk3",
          "libsoup-3.0",
          "libxdo",
          "libappindicator-gtk3",
          "playerctl",
          "spicetify"
        ]
      }
    }
  }
}
